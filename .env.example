# ==============================================================================
# SwaraGPT Environment Configuration
# ==============================================================================

# Database Settings
# PostgreSQL Connection (Default fallback is SQLite swaragpt.db if Postgres is not configured)
DATABASE_URL=postgresql://swara_user:swara_secure_password_dev@localhost:5432/swaragpt

# MongoDB Settings (Optional: Used for high-frequency pitch contours. Fallbacks cleanly to PostgreSQL JSONB)
MONGODB_URL=mongodb://localhost:27017/swaragpt

# Redis Settings (Optional: Caching and task queues)
REDIS_URL=redis://localhost:6379/0

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_please_change_in_production_minimum_32_characters_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration: 'gemini' | 'openai' | 'offline'
# If set to 'offline' or if no API keys are provided, SwaraGPT runs in full pedagogical Demo Mode without failures
AI_PROVIDER=offline

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# MIR Scoring & Thresholds
CENT_TOLERANCE_SUR=25.0
CENT_TOLERANCE_MILD=50.0
WEIGHT_PITCH=0.35
WEIGHT_SWARA=0.25
WEIGHT_SHRUTI=0.15
WEIGHT_RAGA=0.15
WEIGHT_TONIC=0.10

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
